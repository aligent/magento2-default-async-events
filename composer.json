{
    "name": "aligent/magento2-default-async-events",
    "type": "magento2-module",
    "description": "A set of default events for use with the aligent/magento-async-events module",
    "require": {
        "php": ">=7.4",
        "magento/framework": "*",
        "aligent/async-events": "^2.3|^3.0"
    },
    "license": [
        "GPL-3.0-only"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Aligent\\DefaultAsyncEvents\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
